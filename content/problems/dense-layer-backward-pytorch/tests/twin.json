{
  "generator": {
    "why": "Inputs and upstream gradients within ±1, weights within ±1 and biases within ±1, on the numpy generator's 1/16 grid. The numpy generator draws everything up to ±10, so pre-activations reach the thousands and dW sums 100 products of up to 100: float32's rounding of that sum swamps the entries that cancel to near 0 (at ±3, three draws in 3000 still did). Stored cases keep the full range.",
    "dims": {
      "N": [
        1,
        100
      ],
      "Din": [
        1,
        32
      ],
      "Dout": [
        1,
        32
      ]
    },
    "inputs": {
      "X": {
        "$random": {
          "shape": [
            "N",
            "Din"
          ],
          "dist": "uniform",
          "low": [
            -1.0,
            -0.25
          ],
          "high": [
            0.25,
            1.0
          ],
          "step": 0.0625
        }
      },
      "W": {
        "$random": {
          "shape": [
            "Din",
            "Dout"
          ],
          "dist": "uniform",
          "low": [
            -1.0,
            -0.25
          ],
          "high": [
            0.25,
            1.0
          ],
          "step": 0.0625
        }
      },
      "b": {
        "$random": {
          "shape": [
            "Dout"
          ],
          "dist": "uniform",
          "low": -1.0,
          "high": 1.0,
          "step": 0.0625
        }
      },
      "dY": {
        "$random": {
          "shape": [
            "N",
            "Dout"
          ],
          "dist": "uniform",
          "low": -1.0,
          "high": 1.0,
          "step": 0.0625
        }
      },
      "activation": {
        "$random": {
          "dist": "choice",
          "values": [
            "linear",
            "relu",
            "tanh",
            "sigmoid"
          ]
        }
      }
    }
  }
}
