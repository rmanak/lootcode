                      "low": [-1000.0, -1.0], "high": [1.0, 1000.0], "dtype": "float64"}},
    "lr": {"$random": {"dist": "uniform", "low": 0.001, "high": 0.04}},
    "steps": {"$random": {"dist": "randint", "low": 1, "high": 301}}
  }
}
