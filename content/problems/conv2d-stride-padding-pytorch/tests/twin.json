{
  "generator": {
    "why": "Inputs within ±3, weights within ±1 and biases within ±1. The numpy generator draws everything up to ±10: outputs are sums of hundreds of terms in the tens, and float32's cancellation error swamps the small entries. Stored cases keep the full range.",
    "dims": {
      "Cin": [
        1,
        8
      ],
      "Cout": [
        1,
        8
      ],
      "H": [
        1,
        12
      ],
      "W": [
        1,
        12
      ],
      "s": [
        1,
        4
      ],
      "p": [
        0,
        3
      ],
      "r": [
        0,
        9999
      ],
      "kh": "1 + (r % (H + 2*p)) % 7",
      "kw": "1 + (r // 7 % (W + 2*p)) % 7"
    },
    "inputs": {
      "x": {
        "$random": {
          "shape": [
            "Cin",
            "H",
            "W"
          ],
          "dist": "uniform",
          "low": [
            -3.0,
            -0.5
          ],
          "high": [
            0.5,
            3.0
          ]
        }
      },
      "weight": {
        "$random": {
          "shape": [
            "Cout",
            "Cin",
            "kh",
            "kw"
          ],
          "dist": "uniform",
          "low": [
            -1.0,
            -0.05
          ],
          "high": [
            0.05,
            1.0
          ]
        }
      },
      "bias": {
        "$random": {
          "shape": [
            "Cout"
          ],
          "dist": "uniform",
          "low": -1.0,
          "high": 1.0
        }
      },
      "stride": {
        "$dim": "s"
      },
      "padding": {
        "$dim": "p"
      }
    }
  }
}
