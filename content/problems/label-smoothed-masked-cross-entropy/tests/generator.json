{
  "dims": {
    "N": [
      1,
      32
    ],
    "C": [
      2,
      24
    ]
  },
  "inputs": {
    "logits": {
      "$random": {
        "shape": [
          "N",
          "C"
        ],
        "dist": "uniform",
        "low": [
          -1000.0,
          -1.0
        ],
        "high": [
          1.0,
          1000.0
        ],
        "round": 3
      }
    },
    "targets": {
      "$random": {
        "shape": [
          "N"
        ],
        "dist": "randint",
        "high": "C"
      }
    },
    "mask": {
      "$random": {
        "shape": [
          "N"
        ],
        "dist": "randint",
        "high": 2
      }
    },
    "smoothing": {
      "$random": {
        "dist": "choice",
        "values": [
          0.0,
          0.05,
          0.1,
          0.2,
          0.5,
          0.9,
          0.99
        ]
      }
    }
  }
}
