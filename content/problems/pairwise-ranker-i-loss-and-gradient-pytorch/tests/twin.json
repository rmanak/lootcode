{
  "generator": {
    "why": "Features within ±3 and weights within ±1. The numpy generator draws both up to ±100, so scores reach 1e5 and float32's rounding of them swamps the small gradients. Stored cases keep the full range.",
    "dims": {
      "N": [
        1,
        64
      ],
      "d": [
        1,
        20
      ]
    },
    "inputs": {
      "preferences": {
        "$random": {
          "shape": [
            "N",
            2,
            "d"
          ],
          "dist": "uniform",
          "low": [
            -3.0,
            -0.1
          ],
          "high": [
            0.1,
            3.0
          ]
        }
      },
      "w": {
        "$random": {
          "shape": [
            "d"
          ],
          "dist": "uniform",
          "low": [
            -1.0,
            -0.01
          ],
          "high": [
            0.01,
            1.0
          ]
        }
      }
    }
  }
}
