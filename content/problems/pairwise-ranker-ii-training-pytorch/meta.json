            -1.5,
            -0.2
          ],
          "high": [
            0.2,
            1.5
          ]
        }
      },
      "lr": {
        "$random": {
          "dist": "uniform",
          "low": [
            0.001,
            0.04
          ],
          "high": [
            0.05,
            0.085
          ]
        }
      },
      "steps": {
        "$random": {
          "dist": "randint",
          "low": 0,
          "high": 501
        }
      }
    }
  }
