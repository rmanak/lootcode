{
  "slug": "pairwise-ranker-ii-training-pytorch",
  "title": "Pairwise Ranker II: Training (PyTorch)",
  "difficulty": "medium",
  "tags": [
    "machine-learning",
    "optimization",
    "pytorch"
  ],
  "hints": [
    "The procedure is fully specified, so the real work is getting the gradient right at every step. Everything else is bookkeeping.",
    "This is full-batch gradient descent: each step uses all N pairs at once. Compute whatever does not depend on w once, before the loop.",
    "The difference vectors never change during training; only w does. Each step needs just the margins at the current w. Step against the gradient, not along it."
  ],
  "languages": [
    "python"
  ],
  "limits": {
    "timeLimitMs": 10000,
    "memoryLimitMb": 2048
  },
  "function": {
    "name": "trainRanker",
    "params": [
      {
        "name": "preferences",
        "type": "Tensor"
      },
      {
        "name": "lr",
        "type": "float"
      },
      {
        "name": "steps",
        "type": "int"
      }
    ],
    "returns": {
      "type": "Tensor"
    }
  },
  "scoring": {
    "type": "weighted",
    "points": 100
  },
  "compare": "close",
  "runtime": "torch",
  "torch": {
    "twin": "pairwise-ranker-ii-training",
    "rtol": 1e-05,
    "atol": 1e-06,
    "random_tests": 5,
    "forbid": [
      "torch.Tensor.backward",
      "torch.autograd.grad",
      "torch.autograd.backward",
      "torch.autograd.functional.jacobian",
      "torch.autograd.functional.vjp",
      "torch.autograd.functional.jvp",
      "torch.autograd.functional.hessian",
      "torch.autograd.functional.vhp",
      "torch.autograd.functional.hvp",
      "torch.func.grad",
      "torch.func.grad_and_value",
      "torch.func.vjp",
      "torch.func.jvp",
      "torch.func.jacrev",
      "torch.func.jacfwd",
      "torch.func.hessian",
      "torch.func.linearize",
      "torch.autograd.forward_ad.make_dual",
      "torch.autograd.forward_ad.unpack_dual"
    ],
    "dims": {
      "N": [
        1,
        200
      ],
      "d": [
        1,
        10
      ]
    },
    "inputs": {
      "preferences": {
        "$random": {
          "shape": [
            "N",
            2,
            "d"
          ],
          "dist": "uniform",
